{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Faith Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topic",
    "title",
    "summary",
    "scope",
    "verification",
    "sources",
    "updatedAt",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9][a-z0-9_-]{2,90}$"
    },
    "topic": {
      "enum": [
        "talent",
        "build",
        "quest",
        "boss",
        "item",
        "profession",
        "system"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "scope": {
      "enum": [
        "forever",
        "classic",
        "unknown"
      ]
    },
    "verification": {
      "enum": [
        "verifie",
        "a_confirmer",
        "obsolete"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "label",
          "checkedAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 50
      }
    },
    "class": {
      "type": "string",
      "maxLength": 40
    },
    "spec": {
      "type": "string",
      "maxLength": 60
    },
    "levelMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "levelMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "supersedes": {
      "type": "string",
      "maxLength": 100
    },
    "author": {
      "type": "string",
      "maxLength": 100
    }
  }
}
